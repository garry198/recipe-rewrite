# ================= ОБЩИЕ НАСТРОЙКИ =================
GEMINI_API_KEY=
# GEMINI_ACCOUNT_LABEL=default
GEMINI_MODEL=gemini-3.8-flash
THINKING_LEVEL=low  # Доступно: low, medium, high (влияет на токены и время)

DB_HOST=
DB_USER=
DB_PASSWORD=
DB_DATABASE=
DB_PORT=3306

# ================= РЕЖИМ РАБОТЫ =================
# Доступно: "rewrite" (обновление существующих), "translate" (перевод) или "adapt" (recipes3 -> recipe_rewrite)
APP_MODE=rewrite
DRY_RUN=false

# ================= ОСНОВНОЙ РЕЖИМ: adapt (recipes3 -> recipe_rewrite) =================
# Применяются, если APP_MODE=adapt
# ADAPT_IDS=1,2,3
# ADAPT_EXCLUDE_IDS=
ADAPT_LIMIT=10
# ADAPT_DISH_TYPES=dessert,snack
ADAPT_MARKET=US
ADAPT_LOCALE=en_US
ADAPT_STATUS=active
ADAPT_FORCE=0



# ================= НАСТРОЙКИ РЕРАЙТА (US) =================
# Применяются, если APP_MODE=rewrite
RESCALE_TARGET_SERVINGS=4
RESCALE_ONLY_IF_MORE_THAN=8
RESCALE_MAX_DIVISOR=2.5
RESCALE_SMART=1
RESCALE_CANDIDATES=4,6,8,12,16,24,32
# RESCALE_COUNT_RE=\b(?:large|medium|small|extra[- ]large|whole)?\s*(?:eggs?|egg\s+yolks?|egg\s+whites?)\b
FETCH_SIZE=3
SLEEP_BETWEEN_REQUESTS=2.0
# === Строгие проверки рерайта ===
STRICT_REWRITE_CHECKS=1
SKIP_RECIPE_REFS=1

REWRITE_IDS=9146, 9201, 9202, 9203, 9204, 9205, 9206, 9207, 9208, 9209, 9210, 9211, 9212, 9213, 9214, 9215, 9216, 9217, 9218, 9219, 9220, 9221, 9222, 9223, 9224, 9225, 9226, 9227, 9228, 9229, 9230, 9231, 9232, 9233, 9234, 9235, 9236, 9237, 9238, 9239, 9240, 9241, 9242, 9243, 9244, 9245, 9246, 9247, 9248, 9249, 9250, 9251, 9252, 9253, 9254, 9255, 9256, 9257, 9258, 9259, 9260, 9261, 9262, 9263, 9264, 9265, 9266, 9267, 9268, 9269, 9270, 9271, 9272, 9273, 9274, 9275, 9276, 9277, 9278, 9279, 9280, 9281, 9282, 9283, 9284, 9285, 9286, 9287, 9288, 9289, 9290, 9291, 9292, 9293, 9294, 9295, 9296, 9297, 9298, 9299, 9300, 9301, 9302, 9303, 9304, 9305, 9306, 9307, 9308, 9309, 9310, 9311, 9312, 9313, 9314, 9315, 9316

#REWRITE_IDS=4485, 4507, 4522
# ================= НАСТРОЙКИ ПЕРЕВОДА =================
# Применяются, если APP_MODE=translate
TARGET_LANG=fr
TARGET_LOCALE=fr_FR
TARGET_MARKET=fr
TARGET_CURRENCY=EUR
PROMPT_FILE_TRANSLATE=prompts/desserts_translate_prompt_fr_v4.txt
# Для немецкого (DE):
# TARGET_LANG=de
# TARGET_LOCALE=de_DE
# TARGET_MARKET=de
# TARGET_CURRENCY=EUR
# PROMPT_FILE_TRANSLATE=prompts/desserts_translate_prompt_de_v1.txt
# Курс доллара к целевой валюте для пересчета стоимости (например, 0.92 для EUR)
USD_TO_TARGET_RATE=0.92

# Для перевода скрипт берет ID английских строк, из которых делает копию
TRANSLATE_IDS=10,19,32,38,39,43,55,9350,9349, 9348, 9346



# ================= СЛУЖЕБНЫЕ ФАЙЛЫ =================

PROMPT_FILE=prompts/desserts_rewrite_prompt_v3_5.txt
CSV_LOG_FILE=logs/rewrite_update_log.csv
CACHE_TTL_DAYS=30
LOG_LEVEL=INFO